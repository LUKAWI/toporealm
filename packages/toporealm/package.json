{
  "name": "@lukawi/toporealm",
  "version": "1.1.2",
  "description": "TopoRealm 1.0 — single-owner daemon graph workspace (aggregate: toporealm CLI + toporeald daemon). Minimal core, two-layer modules, one local graph shared by humans and agents.",
  "keywords": [
    "agents",
    "cli",
    "daemon",
    "graph",
    "pi-extension",
    "pi-package",
    "toporealm",
    "workflow"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LUKAWI/toporealm.git"
  },
  "homepage": "https://github.com/LUKAWI/toporealm#readme",
  "bugs": {
    "url": "https://github.com/LUKAWI/toporealm/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "toporealm": "./bin/toporealm.mjs",
    "toporeald": "./bin/toporeald.mjs"
  },
  "files": [
    "bin",
    "extensions",
    "skills"
  ],
  "dependencies": {
    "@lukawi/toporealm-cli": "1.1.2",
    "@lukawi/toporealm-client": "1.1.2",
    "@lukawi/toporealm-daemon": "1.1.2",
    "@lukawi/toporealm-distribution": "1.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ]
  }
}
