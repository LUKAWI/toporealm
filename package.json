{
  "name": "toporealm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "toporealm": "dist/cli/main.js"
  },
  "description": "TopoRealm modular graph foundation",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "web:build": "npm --prefix web-ui run build",
    "web:typecheck": "npm --prefix web-ui run typecheck",
    "web:test": "npm --prefix web-ui run test",
    "web:browser-smoke": "vitest run tests/browser-smoke.test.ts",
    "web:verify": "npm run web:typecheck && npm run web:build && npm run web:test",
    "verify": "npm run build && npm test && npm run web:verify"
  },
  "dependencies": {
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
